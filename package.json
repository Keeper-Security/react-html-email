{
  "name": "react-html-email",
  "description": "Create elegant HTML email templates using React.",
  "version": "3.0.2",
  "keywords": [
    "react",
    "html",
    "email"
  ],
  "license": "MIT",
  "author": {
    "name": "Max Goodman",
    "email": "c@chromakode.com"
  },
  "scripts": {
    "lint": "eslint --ext .jsx --ext .js .",
    "test": "jest",
    "test:cov": "jest --coverage",
    "compile": "babel -d lib/ src/ && cp -v src/supportMatrix.json lib/",
    "scrape": "babel-node scripts/scrapeStyleSupport.js > src/supportMatrix.json",
    "prepare": "npm run compile"
  },
  "main": "lib/index.js",
  "repository": "chromakode/react-html-email",
  "devDependencies": {
    "@babel/cli": "^7.27.0",
    "@babel/core": "^7.27.0",
    "@babel/eslint-parser": "^7.27.0",
    "@babel/node": "^7.27.0",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/preset-env": "^7.27.0",
    "@babel/preset-react": "^7.27.0",
    "@eslint/eslintrc": "^3.3.1",
    "babel-jest": "^29.7.0",
    "cheerio": "^1.0.0",
    "eslint": "^9.26.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "node-fetch": "^2.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "dependencies": {
    "prop-types": "^15.8.1"
  },
  "jest": {
    "testPathIgnorePatterns": ["/node_modules/", "/.claude/"]
  }
}
